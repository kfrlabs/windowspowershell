<%- | Stdlib::Windowspath $module_dir,
      String[1]           $version,
| -%>
$ErrorActionPreference = 'Stop'
$moduleDir = '<%= $module_dir %>'
# Unparseable dir: kept (never purged); unparseable pin: only a literal folder match is kept, the rest is purged.
# A single-component pin/dir (e.g. '2') is normalised to '2.0' before -as [version], which needs major.minor.
$pinned = '<%= $version %>'
$pinnedNorm = $pinned
if ($pinnedNorm -match '^\d+$') { $pinnedNorm = $pinnedNorm + '.0' }
$pinnedAs = $pinnedNorm -as [version]
if ($null -ne $pinnedAs) {
    if ($pinnedAs.Build -eq -1) { $pinnedBuild = 0 } else { $pinnedBuild = $pinnedAs.Build }
    if ($pinnedAs.Revision -eq -1) { $pinnedRevision = 0 } else { $pinnedRevision = $pinnedAs.Revision }
}

if (Test-Path -LiteralPath $moduleDir) {
    Get-ChildItem -LiteralPath $moduleDir -Directory |
        Where-Object {
            if ($_.Name -eq $pinned) { $false }
            else {
                $dirName = $_.Name
                if ($dirName -match '^\d+$') { $dirName = $dirName + '.0' }
                $dirAs = $dirName -as [version]
                if ($null -eq $dirAs) { $false }
                elseif ($null -eq $pinnedAs) { $true }
                else {
                    if ($dirAs.Build -eq -1) { $dirBuild = 0 } else { $dirBuild = $dirAs.Build }
                    if ($dirAs.Revision -eq -1) { $dirRevision = 0 } else { $dirRevision = $dirAs.Revision }
                    -not (($dirAs.Major -eq $pinnedAs.Major) -and ($dirAs.Minor -eq $pinnedAs.Minor) -and ($dirBuild -eq $pinnedBuild) -and ($dirRevision -eq $pinnedRevision))
                }
            }
        } |
        ForEach-Object {
            Write-Verbose "Removing side-by-side version $($_.Name)" -Verbose
            Remove-Item -LiteralPath $_.FullName -Recurse -Force
        }
}
