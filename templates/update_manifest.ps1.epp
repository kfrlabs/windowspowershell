<%- | Stdlib::Windowspath $module_path,
      Stdlib::Windowspath $functions_path,
      Stdlib::Windowspath $manifest_path,
      String[1]           $module_name,
      String[1]           $company_name,
      String[1]           $author,
      String[1]           $guid,
      Windowspowershell::Moduleversion $module_version,
| -%>
$ErrorActionPreference = 'Stop'

$modulePath    = '<%= $module_path %>'
$functionsPath = '<%= $functions_path %>'
$manifestPath  = '<%= $manifest_path %>'
$moduleName    = '<%= $module_name %>'

# Only the scripts deployed under Functions/ become NestedModules, and each one
# exports the function it is named after. The root module (<moduleName>.psm1)
# lives at the module root, not under Functions/, and is declared separately as
# -RootModule; scanning Functions/ therefore keeps it out of NestedModules and
# out of FunctionsToExport. Piping through ForEach-Object keeps an empty
# Functions/ safe: it yields @() instead of calling a method on a $null
# FullName, so New-ModuleManifest still gets valid (empty) arrays.
# `-LiteralPath` keeps a `[` or `]` in $functionsPath literal instead of reading
# it as a wildcard character class. The extension filter is applied in the
# pipeline rather than with `-Include`, because `-Include` is silently ignored
# when combined with `-LiteralPath` in Windows PowerShell (it is honoured only
# from PowerShell Core 6.1 on) and the `powershell` Exec provider runs Windows
# PowerShell, so `-Include` would let every file in the tree through. `-File`
# keeps directories out, and the pipeline filter keeps the scan to
# `.ps1`/`.psm1` at any depth (the sub-folder layout is preserved on purpose).
$functions     = @(Get-ChildItem -LiteralPath $functionsPath -Recurse -File |
    Where-Object { $_.Extension -in '.ps1', '.psm1' })
# Defense in depth (issue #111): the manifest command is built from the
# normalized root, but a trailing separator reaching $modulePath would make
# the Replace below miss and leave absolute NestedModules. Trimming keeps
# the prefix match exact on 5.1 (TrimEnd with a char array is 5.1-safe).
$modulePathNormalized = $modulePath.TrimEnd('\','/')
$nestedModules = @($functions | ForEach-Object { $_.FullName.Replace("${modulePathNormalized}\", '') })
$functionNames = @($functions | ForEach-Object { $_.BaseName })

# Fail closed on broken scripts (issue #107): parse every Functions/ script
# before writing the manifest, so a syntax error fails this Exec and leaves
# the existing .psd1 untouched instead of shipping a manifest that lists a
# function PowerShell cannot load. Files are read as UTF-8 explicitly and
# reached through .FullName, mirroring tools/Test-RenderedPowerShell.ps1, so
# a bracketed path stays literal (issue #15). An empty Functions/ is a no-op:
# the loop runs zero times and the manifest is written unchanged.
$failedFiles = @()
foreach ($functionFile in $functions) {
    $scriptText = [System.IO.File]::ReadAllText($functionFile.FullName, [System.Text.Encoding]::UTF8)
    $tokens = $null
    $fileParseErrors = $null
    $ast = [System.Management.Automation.Language.Parser]::ParseInput($scriptText, [ref]$tokens, [ref]$fileParseErrors)
    foreach ($parseError in $fileParseErrors) {
        Write-Error ("PARSE ERROR {0}:{1}: {2}" -f $functionFile.FullName, $parseError.Extent.StartLineNumber, $parseError.Message) -ErrorAction Continue
    }
    if ($fileParseErrors.Count -gt 0) { $failedFiles += $functionFile.FullName }
    else {
        # Name contract (issue #135, step 1): each Functions/ script must
        # define a top-level function named after its own base name,
        # otherwise FunctionsToExport would list a function PowerShell
        # cannot load. $false keeps nested script blocks out of the search;
        # the comparison stays case-insensitive, like PowerShell function
        # resolution. Files are reached through .FullName, so a bracketed
        # path stays literal (issue #15).
        $definedFunctions = $ast.FindAll({ param($node) $node -is [System.Management.Automation.Language.FunctionDefinitionAst] }, $false)
        if ($functionFile.BaseName -notin @($definedFunctions | ForEach-Object { $_.Name })) {
            Write-Error ("CONTRACT ERROR {0}: no function named '{1}' defined in file, manifest not written" -f $functionFile.FullName, $functionFile.BaseName) -ErrorAction Continue
            $failedFiles += $functionFile.FullName
        }
    }
}
if ($failedFiles.Count -gt 0) {
    # `throw` must not be used here: Windows PowerShell 5.1 fed via stdin
    # swallows a `throw` inside a multi-line block and keeps running
    # (exit 0), so Write-Error plus `exit 1` guarantees the failure exit
    # code and keeps New-ModuleManifest from running (issue #107).
    Write-Error ("Errors in Functions/ scripts, manifest not written: {0}" -f ($failedFiles -join ', ')) -ErrorAction Continue
    exit 1
}
# Name contract, duplicates (issue #135, step 1): base names must be unique
# across Functions/, otherwise two NestedModules export the same function
# and the manifest is ambiguous. Group-Object is case-insensitive, matching
# PowerShell function resolution, and BaseName already strips the
# extension, so Foo.ps1 and Foo.psm1 collide on purpose. Same Write-Error
# plus `exit 1` pattern as above: never `throw` (5.1 stdin).
$duplicateGroups = @($functions | Group-Object { $_.BaseName } | Where-Object { $_.Count -gt 1 })
if ($duplicateGroups.Count -gt 0) {
    $duplicateNames = @($duplicateGroups | ForEach-Object { $_.Name }) -join ', '
    Write-Error ("Duplicate function names in Functions/ scripts, manifest not written: {0}" -f $duplicateNames) -ErrorAction Continue
    exit 1
}

New-ModuleManifest -Path $manifestPath `
    -Guid '<%= $guid %>' `
    -RootModule "${moduleName}.psm1" `
    -NestedModules $nestedModules `
    -FileList $nestedModules `
    -FunctionsToExport $functionNames `
    -VariablesToExport '*' `
    -AliasesToExport '*' `
    -Author '<%= $author %>' `
    -CompanyName '<%= $company_name %>' `
    -ModuleVersion '<%= $module_version %>'
