<%- | Stdlib::Windowspath $module_dir,
      String[1]           $version,
| -%>
$moduleDir = '<%= $module_dir %>'

if (-not (Test-Path -LiteralPath $moduleDir)) { exit 0 }

# Unparseable dir: kept (not extra); unparseable pin: only a literal folder match is kept, the rest counts as extra.
# Shared with the install check and the purge via _version_compare.ps1.epp (issue #52).
<%= epp('windowspowershell/_version_compare.ps1.epp', { 'version' => $version }) -%>
$extra = Get-ChildItem -LiteralPath $moduleDir -Directory |
    Where-Object { Test-IsExtraVersion $_.Name }

if ($extra) { exit 1 } else { exit 0 }
