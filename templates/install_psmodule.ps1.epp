<%- | String[1]                             $modulename,
      Optional[String[1]]                   $version,
      String[1]                             $repository,
      Optional[Windowspowershell::Proxyurl] $proxy,
      Boolean                               $use_proxy_credential = false,
| -%>
$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12

<% if $use_proxy_credential { -%>
# The secret comes from the Exec environment, never from this script text
$secure = ConvertTo-SecureString $env:WPS_PROXY_PASSWORD -AsPlainText -Force
$proxyCredential = New-Object System.Management.Automation.PSCredential($env:WPS_PROXY_USER, $secure)

<% } -%>
# -Force also suppresses the prompt raised by an untrusted repository, so the
# repository's InstallationPolicy is left as the administrator set it.
# -Name takes wildcards, so escape them to target the literal module name.
Install-Module -Name '<%= regsubst($modulename, '([`*?\[\]])', '`\1', 'G') %>' `
<% if $version =~ NotUndef { -%>
    -RequiredVersion '<%= $version %>' `
<% } -%>
    -Repository '<%= $repository %>' `
    -Scope AllUsers `
    -Force `
    -AllowClobber `
<% if $proxy =~ NotUndef { -%>
    -Proxy '<%= $proxy %>' `
<% if $use_proxy_credential { -%>
    -ProxyCredential $proxyCredential `
<% } -%>
<% } -%>
    -Verbose
