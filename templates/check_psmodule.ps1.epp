<%- | Stdlib::Windowspath  $module_dir,
      Optional[String[1]]  $version,
| -%>
$moduleDir = '<%= $module_dir %>'

if (-not (Test-Path -LiteralPath $moduleDir)) { exit 1 }

<% if $version =~ NotUndef { -%>
# Pinned check (issue #30): a literal folder match counts, otherwise the folder
# must parse as [version] and be numerically equal to the pin with missing
# segments treated as zero. Unparseable folders never match. Shared with the
# purge and purge-check scripts via _version_compare.ps1.epp (issue #52).
<%= epp('windowspowershell/_version_compare.ps1.epp', { 'version' => $version }) -%>
$found = Get-ChildItem -LiteralPath $moduleDir -Directory -ErrorAction SilentlyContinue |
    Where-Object { Test-PinnedVersionMatch $_.Name }
<% } else { -%>
# No pin: any installed version satisfies the check, but only a folder that parses as a [version]
# is a version. A stray folder (backup, temp, etc.) must not make the module look installed.
<%= epp('windowspowershell/_version_compare.ps1.epp') -%>
$found = Get-ChildItem -LiteralPath $moduleDir -Directory -ErrorAction SilentlyContinue |
    Where-Object { $null -ne (Get-NormalizedVersion $_.Name) }
<% } -%>
if ($found) { exit 0 } else { exit 1 }
